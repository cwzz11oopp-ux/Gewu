COMPETITION_MODE=true
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_GENERAL_MODEL=qwen3.7-plus
QWEN_REASONING_MODEL=qwen3.7-max
QWEN_CODE_MODEL=qwen3-coder-plus
QWEN_CODE_FALLBACK_MODEL=qwen3-coder-flash
QWEN_FAST_MODEL=qwen3.6-flash
# Set to 0 to omit the client-side output cap; the provider's model limit still applies.
QWEN_MAX_TOKENS=0
QWEN_RETRIES_PER_MODEL=1
QWEN_REASONING_TIMEOUT_SECONDS=600
QWEN_GENERAL_TIMEOUT_SECONDS=300
QWEN_CODE_TIMEOUT_SECONDS=600
QWEN_FAST_TIMEOUT_SECONDS=120
FEEDBACK_MAX_ITERATIONS=4
LITERATURE_PROVIDER=arxiv_semantic_scholar
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_MAX_RESULTS=10
EXPERIMENT_PROVIDER=local_gpu
EXPERIMENT_TIMEOUT_SECONDS=1200
REMOTE_GPU_HOST=
REMOTE_GPU_USER=
REMOTE_GPU_PORT=22
REMOTE_GPU_SSH_KEY_PATH=
REMOTE_GPU_PROJECT_DIR=
REMOTE_GPU_PYTHON=python
REMOTE_GPU_CUDA_VISIBLE_DEVICES=
LOCAL_GPU_ENABLED=false
LOCAL_EXPERIMENT_WORKDIR=experiments
LOCAL_GPU_PYTHON=python
LOCAL_GPU_CUDA_VISIBLE_DEVICES=0
DATA_DIR=backend/data
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
